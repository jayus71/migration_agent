@@ -0,0 +1,96 @@
+"""Recheck archived candidates without a translator or repair LLM call."""
+import ast
+import csv
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+from autofix.verifiers.paired_code_report import generate_paired_code_harness
+
+
+REPO = Path(__file__).resolve().parents[1]
+ORIGINAL_REPO = REPO.parent / "ascend-torch4ms-exp-i-core-8c5c635"
+RUN = ORIGINAL_REPO / "experiments/experiment_request_20260820/09_experiment_I_real_translation/runs_real_core_v3"
+OUT = REPO / "experiments/backend_authenticity_audit_20260917"
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def run_one(row, stage):
+    folder = RUN / "tasks" / row["task_id"] / row["method"]
+    candidate = folder / f"candidate_{stage}.py"
+    trace = json.loads((folder / "run_trace.json").read_text())
+    params = dict(trace["config"]["params"])
+    params.update(source_path=str(folder / "source.py"), converted_path=str(candidate))
+    dest = OUT / row["task_id"] / row["method"] / stage
+    dest.mkdir(parents=True, exist_ok=True)
+    harness = dest / "harness.py"
+    report = dest / "report.json"
+    generate_paired_code_harness(params, harness, report)
+    env = dict(os.environ)
+    # Finals use the exact method-local adapter snapshot; initial translations
+    # use the unchanged original repo matching their common initial core tree.
+    adapter_root = folder if stage == "final" else ORIGINAL_REPO
+    env.update(PYTHONPATH=str(adapter_root) + os.pathsep + str(REPO), PYTHONDONTWRITEBYTECODE="1")
+    with (dest / "run.log").open("w") as log:
+        try:
+            process = subprocess.run([sys.executable, str(harness)], cwd=dest, env=env,
+                                     stdout=log, stderr=subprocess.STDOUT, timeout=180)
+            returncode = process.returncode
+        except subprocess.TimeoutExpired:
+            returncode = "timeout"
+    result = json.loads(report.read_text()) if report.exists() else {}
+    target = result.get("results", {}).get("torch4ms", {})
+    original_accepted = row["strict_success"] == "True"
+    backend = target.get("backend_execution", {})
+    observed = bool(backend.get("steps")) and all(s["observed"] for s in backend["steps"])
+    train = next(n for n in ast.parse(candidate.read_text()).body if isinstance(n, ast.FunctionDef) and n.name == "train_one_step")
+    item = {
+        "task_id": row["task_id"], "method": row["method"], "stage": stage,
+        "original_strict_success": original_accepted,
+        "initial_failure_layer": row["natural_initial_failure_layer"],
+        "candidate_sha256": sha(candidate), "source_sha256": sha(folder / "source.py"),
+        "candidate": str(candidate), "training_entry": ast.unparse(train),
+        "returncode": returncode, "execution_status": target.get("status", "missing_report"),
+        "backend_observed": observed, "backend_execution": backend,
+        "error": target.get("error", ""), "comparison": result.get("comparison"),
+        "report": str(report),
+    }
+    if stage == "final":
+        item["corrected_strict_success"] = original_accepted and observed and target.get("status") == "ok"
+    return item
+
+
+def main():
+    OUT.mkdir(parents=True, exist_ok=True)
+    rows = list(csv.DictReader((RUN / "summary.csv").open()))
+    original_summary_sha = sha(RUN / "summary.csv")
+    results = []
+    for row in rows:
+        stages = ["initial", "final"] if row["method"] == "r_direct" else ["final"]
+        for stage in stages:
+            item = run_one(row, stage)
+            results.append(item)
+            (OUT / "audit.json").write_text(json.dumps({"original_summary_sha256": original_summary_sha, "results": results}, indent=2))
+            print(item["task_id"], item["method"], stage, item["execution_status"], item["backend_observed"], flush=True)
+    assert sha(RUN / "summary.csv") == original_summary_sha
+    finals = [r for r in results if r["stage"] == "final"]
+    columns = ["task_id", "method", "original_strict_success", "corrected_strict_success", "initial_failure_layer", "backend_observed", "execution_status", "candidate_sha256", "error"]
+    with (OUT / "corrected_scores.csv").open("w") as file:
+        writer = csv.DictWriter(file, fieldnames=columns, extrasaction="ignore")
+        writer.writeheader()
+        writer.writerows(finals)
+    for method in ("r_hier", "r_direct"):
+        group = [r for r in finals if r["method"] == method]
+        failed_initial = [r for r in group if r["initial_failure_layer"] != "none"]
+        print(method, "accepted", sum(r["corrected_strict_success"] for r in group), "/", len(group),
+              "repaired", sum(r["corrected_strict_success"] for r in failed_initial), "/", len(failed_initial))
+
+
+if __name__ == "__main__":
+    main()
