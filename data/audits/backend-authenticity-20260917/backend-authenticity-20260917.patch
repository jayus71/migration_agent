new file mode 100644
index 0000000..8141335
--- /dev/null
+++ b/test/test_paired_backend_execution.py
@@ -0,0 +1,119 @@
+"""Integration tests: execute actual PyTorch and MindSpore on tiny models."""
+import sys
+import types
+import unittest
+
+import mindspore as ms
+import torch
+import torch.nn as nn
+import torch4ms
+from torch4ms.autograd.ms_autograd_function import extract_and_wrap_loss_fn
+from torch4ms.optim import Torch4msOptimizer
+
+from autofix.verifiers.paired_code_report import _render_harness
+
+
+def source_train(model, x, y, lr=1e-3):
+    optimizer = torch.optim.SGD(model.parameters(), lr=lr)
+    optimizer.zero_grad()
+    loss = nn.CrossEntropyLoss()(model(x), y)
+    loss.backward()
+    optimizer.step()
+    return float(loss.detach().item())
+
+
+def imported_only_train(model, x, y, lr=1e-3):
+    import torch4ms  # An import cannot establish execution provenance.
+    return source_train(model, x, y, lr)
+
+
+def unrelated_target_op_train(model, x, y, lr=1e-3):
+    ms.ops.sin(ms.Tensor([1.0]))
+    return source_train(model, x, y, lr)
+
+
+def target_train(model, x, y, lr=1e-3):
+    # Native torch optimizer writeback is part of the supported adapter.
+    optimizer = Torch4msOptimizer(torch.optim.SGD(model.parameters(), lr=lr), model)
+    with torch4ms.default_env():
+        optimizer.zero_grad()
+        loss = extract_and_wrap_loss_fn(model, nn.CrossEntropyLoss(), x, y).output
+        loss.backward(module=model)
+        optimizer.step()
+        optimizer.zero_grad()  # Provenance must survive legitimate grad clearing.
+        return float(loss.detach().item())
+
+
+def unrelated_target_backward_train(model, x, y, lr=1e-3):
+    other_model = nn.Linear(3, 2)
+    target_train(other_model, x, y, lr)
+    return source_train(model, x, y, lr)
+
+
+class PairedBackendExecutionTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.ns = {"__name__": "paired_backend_test_harness"}
+        exec(compile(_render_harness({}), "paired_backend_test_harness.py", "exec"), cls.ns)
+
+    def run_side(self, train, label="torch4ms", use_env=True, entry="train_one_step", steps=1):
+        torch.manual_seed(13)
+        model = nn.Linear(3, 2)
+        module = types.SimpleNamespace(train_one_step=train)
+        batches = [(torch.randn(4, 3), torch.tensor([0, 1, 1, 0])) for _ in range(steps)]
+        params = {"mode": "train", "device": "cpu", "lr": 0.01, "collect_layers": False}
+        previous = sys.getprofile()
+        result, _, _ = self.ns["_run_side"](label, module, model, batches, params, use_env, entry)
+        self.assertIs(sys.getprofile(), previous)
+        return result
+
+    def assert_rejected(self, train, **kwargs):
+        result = self.run_side(train, **kwargs)
+        self.assertEqual(result["status"], "failed", result)
+        self.assertIn("target_backend_not_observed", result["error"])
+
+    def test_source_training_is_allowed_for_reference(self):
+        self.assertEqual(self.run_side(source_train, label="torch", use_env=False)["status"], "ok")
+
+    def test_pure_source_training_is_rejected_for_target(self):
+        self.assert_rejected(source_train)
+
+    def test_import_does_not_count(self):
+        self.assert_rejected(imported_only_train)
+
+    def test_unrelated_target_operator_does_not_count(self):
+        self.assert_rejected(unrelated_target_op_train)
+
+    def test_unrelated_model_backward_does_not_count(self):
+        self.assert_rejected(unrelated_target_backward_train)
+
+    def test_disabling_auto_environment_does_not_disable_contract(self):
+        self.assert_rejected(source_train, use_env=False)
+
+    def test_managed_native_training_is_rejected(self):
+        self.assert_rejected(source_train, use_env=False, entry="")
+
+    def test_candidate_owned_target_training_passes(self):
+        result = self.run_side(target_train)
+        self.assertEqual(result["status"], "ok", result)
+        self.assertTrue(result["backend_execution"]["steps"][0]["observed"])
+
+    def test_harness_owned_target_training_passes(self):
+        result = self.run_side(target_train, entry="")
+        self.assertEqual(result["status"], "ok", result)
+
+    def test_target_first_step_cannot_cover_source_second_step(self):
+        calls = []
+
+        def mixed_train(model, x, y, lr=1e-3):
+            train = source_train if calls else target_train
+            calls.append(True)
+            return train(model, x, y, lr)
+
+        result = self.run_side(mixed_train, steps=2)
+        self.assertEqual(result["status"], "failed", result)
+        self.assertEqual([s["observed"] for s in result["backend_execution"]["steps"]], [True, False])
+
+
+if __name__ == "__main__":
+    unittest.main()
