diff --git a/autofix/verifiers/backend_execution.py b/autofix/verifiers/backend_execution.py
new file mode 100644
index 0000000..6221f78
--- /dev/null
+++ b/autofix/verifiers/backend_execution.py
@@ -0,0 +1,96 @@
+"""Runtime provenance for paired torch4ms training, independent of imports.
+
+This observes the existing candidate; it never wraps its training in an adapter
+environment or changes its optimizer.  The supported backend is the torch4ms
+autograd bridge used by paired_code_report.  Native MindSpore programs use the
+separate native MindSpore verifier.
+"""
+import math
+import sys
+
+
+class TargetBackendNotObserved(RuntimeError):
+    pass
+
+
+class TargetBackendObserver:
+    """Require MindSpore gradients for this model and this returned loss."""
+
+    def __init__(self, model):
+        import mindspore
+        import torch4ms.autograd as autograd
+        from torch4ms.tensor import Tensor
+
+        self.model = model
+        self.ms_tensor = mindspore.Tensor
+        self.target_tensor = Tensor
+        self.parameter_ids = {id(p) for p in model.parameters()}
+        self.codes = {
+            autograd._run_backward.__code__: "backward",
+            autograd._run_grad.__code__: "grad",
+        }
+        self.previous_profile = None
+        self.events = []
+        self.steps = []
+
+    def start(self):
+        self.previous_profile = sys.getprofile()
+        sys.setprofile(self._profile)
+
+    def stop(self):
+        sys.setprofile(self.previous_profile)
+
+    def begin_step(self):
+        self.events = []
+
+    def _belongs_to_model(self, frame):
+        if frame.f_locals.get("module") is self.model:
+            return True
+        caller = frame.f_back
+        if caller is not None and caller.f_locals.get("module") is self.model:
+            return True
+        inputs = frame.f_locals.get("inputs", ())
+        known_ids = self.parameter_ids | {
+            id(p) for p in getattr(self.model, "_torch4ms_param_tensor_cache", ())
+        }
+        return any(id(p) in known_ids for p in inputs)
+
+    def _profile(self, frame, event, arg):
+        if self.previous_profile is not None:
+            self.previous_profile(frame, event, arg)
+        if event != "return" or frame.f_code not in self.codes:
+            return
+        if not self._belongs_to_model(frame):
+            return
+        # These locals are the actual result of MindSpore GradOperation, not a
+        # candidate-supplied flag, import, or a call to an unrelated target op.
+        gradients = frame.f_locals.get("grads", ())
+        if isinstance(gradients, self.ms_tensor):
+            gradients = (gradients,)
+        if not isinstance(gradients, (tuple, list)):
+            return
+        count = sum(isinstance(g, self.ms_tensor) for g in gradients)
+        outputs = frame.f_locals.get("tensors", frame.f_locals.get("outputs", ()))
+        if count and len(outputs) == 1 and isinstance(outputs[0], self.target_tensor):
+            self.events.append((outputs[0], count, self.codes[frame.f_code]))
+
+    def check_step(self, loss):
+        """Validate target gradient provenance before the next training step."""
+        value = float(loss)
+        matches = []
+        for output, count, method in self.events:
+            # Read the underlying MindSpore scalar without invoking dispatch.
+            observed = float(output._elem.asnumpy().reshape(-1)[0])
+            if math.isclose(value, observed, rel_tol=1e-6, abs_tol=1e-8):
+                matches.append({"gradient_tensors": count, "autograd": method})
+        evidence = {"step": len(self.steps) + 1, "observed": bool(matches), "events": matches}
+        self.steps.append(evidence)
+        if not matches:
+            raise TargetBackendNotObserved(
+                "target_backend_not_observed: no MindSpore gradient computation "
+                "for the evaluated model and returned training loss; ordinary "
+                "PyTorch training does not satisfy the migration contract"
+            )
+
+    def report(self):
+        return {"required": True, "backend": "torch4ms/MindSpore", "steps": self.steps}
